<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.spendsmart</groupId>
    <artifactId>spendsmart-backend</artifactId>
    <version>1.0.0</version>
    <name>SpendSmart Expenses API</name>
    <description>Personal expense management REST API</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.17</springdoc.version>

        <!--
          Security patch overrides of Spring Boot 3.5.16's managed versions (Trivy, 2026-10-22). Same minor lines,
          patch releases only. Remove each override once a Spring Boot release manages an equal or newer version.
            tomcat     10.1.55 -> CVE-2026-65182, CVE-2026-65905, CVE-2026-68525 (CRITICAL)
            jackson    2.21.4  -> CVE-2026-89407, -89425, -68497, -91776, -91777 (HIGH) and 6 MEDIUM
            pgjdbc     42.7.11 -> CVE-2026-54291 (HIGH)
            lang3      3.17.0  -> CVE-2025-48924 (MEDIUM)
            log4j-api  2.24.3  -> CVE-2026-49844 (MEDIUM)
          spring-webmvc 6.2.19 findings (CVE-2026-47884, CVE-2026-47890) are fixed only in Framework 7 and are not
          reachable here; see .trivyignore and docs/SECURITY.md.
        -->
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <postgresql.version>42.7.14</postgresql.version>
        <commons-lang3.version>3.21.0</commons-lang3.version>
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
          Runs the WHOLE test suite against a throwaway PostgreSQL 16 (Testcontainers JDBC URL) instead of H2:
            ./mvnw test -Ppostgres
          Requires a running Docker daemon. DatabaseEngineTest fails the build if the tests silently ran on H2.
        -->
        <profile>
            <id>postgres</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <spring.datasource.url>jdbc:tc:postgresql:16-alpine:///spendsmart</spring.datasource.url>
                                <spring.datasource.driver-class-name>org.testcontainers.jdbc.ContainerDatabaseDriver</spring.datasource.driver-class-name>
                                <spendsmart.test.expected-database>PostgreSQL</spendsmart.test.expected-database>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <finalName>spendsmart</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
