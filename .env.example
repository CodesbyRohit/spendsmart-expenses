# Copy to .env and choose your own values. .env is git-ignored — never commit real credentials.

# PostgreSQL (used by docker compose and by the backend's dev/prod profiles)
DB_USERNAME=spendsmart
DB_PASSWORD=change-me-to-a-long-random-value
# Host port for the compose database. Change it (e.g. 5433) if 5432 is already in use, and match it in DB_URL.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/spendsmart
# Host port for `docker compose --profile app up`
APP_PORT=8080

# Backend
SPRING_PROFILES_ACTIVE=dev
# true behind HTTPS (production). false only for plain-http local testing.
COOKIE_SECURE=false
# Comma-separated origins allowed for cross-origin API calls. Leave empty for same-origin (recommended).
APP_CORS_ALLOWED_ORIGINS=
# Serve the API explorer at /api/docs (defaults: on in dev/local, off in prod)
APP_API_DOCS_ENABLED=true
