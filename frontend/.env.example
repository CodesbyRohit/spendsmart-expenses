# Copy to .env.local if you need to change these. No secrets belong in frontend env files —
# everything prefixed VITE_ is embedded in the public JavaScript bundle.

# Base URL for API calls. Leave empty for the recommended same-origin setup
# (Vite dev proxy in development, Spring Boot serving the built app in production).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api requests.
SPENDSMART_BACKEND_URL=http://localhost:8080
