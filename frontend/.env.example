# Copy to .env.local if you need to change these. No secrets belong in frontend env files —
# everything prefixed VITE_ is embedded in the public JavaScript bundle.

# Base URL for API calls. Leave empty (the recommended setup everywhere):
# - development: the Vite dev server proxies /api to Spring Boot (SPENDSMART_BACKEND_URL below);
# - production on Vercel: frontend/vercel.ts proxies /api to the backend configured via the
#   SPENDSMART_API_ORIGIN environment variable in Vercel's dashboard (see docs/DEPLOYMENT.md).
# Only set this for an exotic split-origin deployment, which would also need CORS and SameSite=None cookies.
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api requests.
SPENDSMART_BACKEND_URL=http://localhost:8080
